@{
    ViewData["Title"] = "Access Denied";
    Layout = "_AccountLayout";
}

<div class="card shadow-sm text-center" style="width: 400px;">
    <div class="card-body p-4">
        <i class="fa-solid fa-lock fa-2x text-danger mb-3"></i>
        <h4>Access Denied</h4>
        <p class="text-muted">You don't have permission to view this page.</p>
        <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Back to Login</a>
    </div>
</div>
