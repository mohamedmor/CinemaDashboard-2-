@using CinemaDashboard.Services
@inject CartService CartServiceInstance
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cinema Store</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <link href="~/css/store.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-dark bg-dark navbar-expand px-4">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
            <i class="fa-solid fa-film me-2"></i>Cinema Store
        </a>
        <div class="ms-auto d-flex align-items-center gap-2">
            <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">
                <i class="fa-solid fa-user-shield"></i> Staff Login
            </a>
            <a class="btn btn-outline-light position-relative" asp-controller="Cart" asp-action="Index">
                <i class="fa-solid fa-cart-shopping"></i> Cart
                <span class="badge bg-danger rounded-pill position-absolute top-0 start-100 translate-middle">
                    @CartServiceInstance.GetItemCount()
                </span>
            </a>
        </div>
    </nav>

    <main class="container py-4">
        @if (TempData["CartMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["CartMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
