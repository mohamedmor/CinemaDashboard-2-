@model IEnumerable<CinemaDashboard.Models.Movie>
@{
    ViewData["Title"] = "Now Showing";
}

<h2 class="mb-4">Now Showing</h2>

<div class="row g-4">
    @foreach (var movie in Model)
    {
        <div class="col-md-3">
            <div class="card movie-card h-100 shadow-sm">
                @if (!string.IsNullOrEmpty(movie.MainImg))
                {
                    <img src="~/uploads/movies/@movie.MainImg" class="card-img-top" alt="@movie.Name" />
                }
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@movie.Name</h5>
                    <p class="text-muted small mb-1">@movie.Category?.Name · @movie.Cinema?.Name</p>
                    <p class="fw-bold mb-2">@movie.Price.ToString("C")</p>
                    <span class="badge bg-secondary mb-3 align-self-start">@movie.Status</span>

                    <div class="mt-auto d-flex gap-2">
                        <a class="btn btn-outline-primary btn-sm flex-fill" asp-action="Details" asp-route-id="@movie.Id">Details</a>
                        <form asp-controller="Cart" asp-action="Add" method="post" class="flex-fill">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="movieId" value="@movie.Id" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit" class="btn btn-primary btn-sm w-100">
                                <i class="fa-solid fa-cart-plus"></i> Add
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <p class="text-muted">No movies available yet. Add some from the admin dashboard.</p>
}
