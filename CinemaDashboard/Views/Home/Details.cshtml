@model CinemaDashboard.Models.Movie
@{
    ViewData["Title"] = Model.Name;
}

<a class="btn btn-link ps-0 mb-3" asp-action="Index"><i class="fa-solid fa-arrow-left"></i> Back to catalog</a>

<div class="row">
    <div class="col-md-5">
        @if (!string.IsNullOrEmpty(Model.MainImg))
        {
            <img src="~/uploads/movies/@Model.MainImg" class="img-fluid rounded shadow-sm mb-3" alt="@Model.Name" />
        }

        @if (Model.SubImages.Any())
        {
            <div class="d-flex flex-wrap gap-2">
                @foreach (var img in Model.SubImages)
                {
                    <img src="~/uploads/movies/@img.ImagePath" class="cart-thumb" />
                }
            </div>
        }
    </div>

    <div class="col-md-7">
        <h2>@Model.Name</h2>
        <p class="text-muted">@Model.Category?.Name · @Model.Cinema?.Name</p>
        <span class="badge bg-secondary mb-3">@Model.Status</span>
        <p>@Model.Description</p>

        <p class="fs-4 fw-bold">@Model.Price.ToString("C")</p>
        <p class="text-muted"><i class="fa-solid fa-calendar me-1"></i>@Model.DateTime.ToString("yyyy-MM-dd HH:mm")</p>

        @if (Model.MovieActors.Any())
        {
            <h5 class="mt-4">Cast</h5>
            <div class="d-flex flex-wrap gap-3">
                @foreach (var ma in Model.MovieActors)
                {
                    <div class="text-center" style="width: 90px;">
                        @if (!string.IsNullOrEmpty(ma.Actor.Img))
                        {
                            <img src="~/uploads/actors/@ma.Actor.Img" class="rounded-circle mb-1" style="width:70px;height:70px;object-fit:cover;" />
                        }
                        <div class="small">@ma.Actor.Name</div>
                    </div>
                }
            </div>
        }

        <form asp-controller="Cart" asp-action="Add" method="post" class="mt-4 d-flex align-items-end gap-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="movieId" value="@Model.Id" />
            <div>
                <label class="form-label">Tickets</label>
                <input type="number" name="quantity" value="1" min="1" class="form-control" style="width: 100px;" />
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-cart-plus me-1"></i>Add to Cart
            </button>
        </form>
    </div>
</div>
