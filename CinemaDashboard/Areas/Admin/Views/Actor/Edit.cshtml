@model CinemaDashboard.Models.Actor
@{
    ViewData["Title"] = "Edit Actor";
}

<h2 class="mb-3">Edit Actor</h2>

<div class="card" style="max-width: 600px;">
    <div class="card-body">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Name</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Image</label>
                @if (!string.IsNullOrEmpty(Model.Img))
                {
                    <div class="mb-2"><img src="~/uploads/actors/@Model.Img" class="thumb" /></div>
                }
                <input type="file" name="ImgFile" class="form-control" accept="image/*" />
                <small class="text-muted">Leave empty to keep the current image.</small>
            </div>

            <button type="submit" class="btn btn-success">Save</button>
            <a class="btn btn-secondary" asp-action="Index">Back</a>
        </form>
    </div>
</div>
