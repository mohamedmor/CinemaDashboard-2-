<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cinema Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <link href="~/css/admin.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-dark bg-dark navbar-expand static-top px-3">
        <a class="navbar-brand" asp-area="Admin" asp-controller="Home" asp-action="Index">
            <i class="fa-solid fa-film me-2"></i>Cinema Admin
        </a>
        <div class="ms-auto d-flex align-items-center text-white">
            <span class="me-3"><i class="fa-solid fa-user me-1"></i>@User.Identity.Name</span>
            <form asp-controller="Account" asp-action="Logout" asp-area="" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
            </form>
        </div>
    </nav>

    <div class="d-flex">
        <nav class="sidebar bg-dark text-white p-3">
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link text-white" asp-area="Admin" asp-controller="Home" asp-action="Index">
                        <i class="fa-solid fa-gauge me-2"></i>Dashboard
                    </a>
                </li>
                <li class="nav-item mt-2">
                    <span class="text-uppercase small text-white-50">Catalog</span>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" asp-area="Admin" asp-controller="Category" asp-action="Index">
                        <i class="fa-solid fa-tags me-2"></i>Categories
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" asp-area="Admin" asp-controller="Cinema" asp-action="Index">
                        <i class="fa-solid fa-building me-2"></i>Cinemas
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" asp-area="Admin" asp-controller="Actor" asp-action="Index">
                        <i class="fa-solid fa-user-tie me-2"></i>Actors
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" asp-area="Admin" asp-controller="Movie" asp-action="Index">
                        <i class="fa-solid fa-clapperboard me-2"></i>Movies
                    </a>
                </li>
            </ul>
        </nav>

        <main class="flex-fill p-4">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
